# Copy to .env and fill in. Never commit .env.
# The core app runs offline and needs none of these to start.

# DHIS2 instance that synced records are sent to. Use the public demo server, never a real facility.
DHIS2_BASE_URL=https://play.dhis2.org/demo
# DHIS2 user for the demo server (fake value)
DHIS2_USERNAME=demo-user
# DHIS2 password for the demo server (fake value)
DHIS2_PASSWORD=change-me
# Hugging Face token, only needed by scripts/fetch-models for gated models (fake value)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
