    { "id": "s0_consent", "section": 0, "textEn": "Your answers go only to the clinic staff. May we ask you some questions and record one answer?", "textLg": "", "audio": "s0_consent.m4a", "type": "yesNo", "next": { "yes": "s1_who", "no": "end_no_consent", "not_sure": "end_no_consent", "ask_clinician": "end_no_consent" }, "target": "consent" },

