    { "id": "s5_trend", "section": 5, "textEn": "Is it getting better, worse, or staying the same?", "textLg": "", "audio": "s5_trend.m4a", "type": "choice", "options": ["better", "worse", "same"], "next": "s5_symptoms", "target": "consultation" },
    { "id": "s5_symptoms", "section": 5, "textEn": "Common symptom questions, one yes/no each, from the fixed symptom list in app/shared/field-schemas.ts.", "textLg": "", "audio": null, "type": "yesNo", "fromSchema": "patient_reported_symptoms", "next": "s6_medicines", "target": "consultation" },

