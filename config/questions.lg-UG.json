    { "id": "s6_daily", "section": 6, "private": true, "textEn": "Do you take any medicine every day?", "textLg": "", "audio": "s6_daily.m4a", "type": "yesNo", "next": "s6_allergies", "target": "consultation" },
    { "id": "s6_allergies", "section": 6, "private": true, "textEn": "Are you allergic to any medicine?", "textLg": "", "audio": "s6_allergies.m4a", "type": "yesNo", "next": "s6_private", "target": "consultation" },
    { "id": "s6_private", "section": 6, "private": true, "textEn": "Is there something private you would rather tell the clinician alone?", "textLg": "", "audio": "s6_private.m4a", "type": "yesNo", "next": "s7_readback", "target": "consultation" },

    { "id": "s7_readback", "section": 7, "textEn": "Here is what we noted. Is it correct?", "textLg": "", "audio": "s7_readback.m4a", "type": "readBack", "next": { "correct": "end", "change": "s4_main" }, "target": null },
