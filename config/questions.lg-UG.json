    { "id": "s1_child_age", "section": 1, "textEn": "How old is the child?", "textLg": "", "audio": "s1_child_age.m4a", "type": "choice", "options": ["under_2_months", "2_months_to_5_years", "over_5_years"], "next": "s2_danger", "target": "dangerSet" },
