    { "id": "s2_danger", "section": 2, "textEn": "Danger-sign questions for the matching set (newborn, child, pregnancy, adult). The list comes from rules/danger-signs.json, one yes/no question per sign. Any yes, or not_sure in the pregnancy set, raises the urgent flag immediately.", "textLg": "", "audio": null, "type": "yesNo", "fromRules": "danger-signs", "next": "s3_name", "target": "urgent" },

    { "id": "s3_name", "section": 3, "textEn": "What is your name? The clerk will check the spelling.", "textLg": "", "audio": "s3_name.m4a", "type": "spoken", "next": "s3_village", "target": "hmis031:col2" },
    { "id": "s3_village", "section": 3, "textEn": "Which village and parish do you live in?", "textLg": "", "audio": "s3_village.m4a", "type": "spoken", "next": "s3_age", "target": "hmis031:col3-5" },
    { "id": "s3_age", "section": 3, "textEn": "How old are you?", "textLg": "", "audio": "s3_age.m4a", "type": "number", "next": "s3_sex", "target": "hmis031:col3-5" },
    { "id": "s3_sex", "section": 3, "textEn": "Are you female or male?", "textLg": "", "audio": "s3_sex.m4a", "type": "choice", "options": ["female", "male"], "next": "s3_next_of_kin", "target": "hmis031:col3-5" },
    { "id": "s3_next_of_kin", "section": 3, "textEn": "Who should we contact if needed, and what is their phone number?", "textLg": "", "audio": "s3_next_of_kin.m4a", "type": "spoken", "next": "s3_repeat", "target": "hmis031:col7" },
    { "id": "s3_repeat", "section": 3, "textEn": "Have you been to this clinic before for this problem?", "textLg": "", "audio": "s3_repeat.m4a", "type": "yesNo", "next": "s3_referral", "target": "hmis031:col8" },
    { "id": "s3_referral", "section": 3, "textEn": "Were you sent here by another clinic or health worker?", "textLg": "", "audio": "s3_referral.m4a", "type": "yesNo", "next": "s4_main", "target": "hmis031:col11" },

    { "id": "s4_main", "section": 4, "textEn": "Tell us in your own words what brings you here today.", "textLg": "", "audio": "s4_main.m4a", "type": "spoken", "retryOnLowConfidence": 1, "next": "s5_duration", "target": "consultation" },

